# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Vertex AI / Gemini
GEMINI_MODEL=gemini-3.5-flash

# Event Bus backend: "memory" (local/test) or "pubsub" (deployed)
EVENT_BUS_BACKEND=pubsub
PUBSUB_TOPIC_EVENTS=crisismesh-events

# Content Scanner backend: "regex" (InjectionGuard) or "model_armor" (Google Model Armor)
ARMOR_BACKEND=regex
ARMOR_TEMPLATE=crisismesh-guard

# Firestore
FIRESTORE_DATABASE=(default)

# Slack
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_APP_TOKEN=xapp-your-token
SLACK_SIGNING_SECRET=your-signing-secret

# Cloud Storage
GCS_BUCKET=crisismesh-data
