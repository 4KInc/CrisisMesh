# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Vertex AI / Gemini
GEMINI_MODEL=gemini-3.5-flash

# Event Bus backend: "memory" (local/test) or "pubsub" (deployed)
EVENT_BUS_BACKEND=pubsub
PUBSUB_TOPIC_EVENTS=crisismesh-events

# Content Scanner backend: "regex" (InjectionGuard) or "model_armor" (Google Model Armor)
ARMOR_BACKEND=regex
ARMOR_TEMPLATE=crisismesh-guard

# Firestore
FIRESTORE_DATABASE=(default)

# Slack (Events API mode — required for /slack/commands and /slack/events)
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_APP_TOKEN=xapp-your-token
SLACK_SIGNING_SECRET=your-signing-secret

# Twilio SMS (optional — /sms endpoint is inert without these)
#
# Inbound: TWILIO_AUTH_TOKEN signs the webhook and is what /sms verifies.
# Outbound: TWILIO_ACCOUNT_SID + TWILIO_PHONE_NUMBER, plus either an API key
# (preferred — revocable on its own) or the account auth token.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-api-key-secret

# The CrisisMesh sender. A2P 10DLC campaign linking is pending on this number.
TWILIO_PHONE_NUMBER=+17722971783

# Outbound kill switch: "twilio" (default when unset) or "off".
# Set to off for drills and replays so a rehearsal cannot page a real roster.
CRISISMESH_SMS_MODE=twilio

# Demo only: map a real handset to a roster person without committing the
# number. SMS/WhatsApp have no login, so an inbound check-in is attributed by
# phone number alone. Unset in production, where staff numbers belong on the
# roster the organisation maintains.
# CRISISMESH_DEMO_PHONE=+15550001111
# CRISISMESH_DEMO_PERSON=p001
# CRISISMESH_DEMO_PHONE_MAP=+15550001111=p001,+15550002222=p004

# Business identity surfaced in the carrier-mandated HELP reply.
CRISISMESH_SUPPORT_EMAIL=heartlinmachado@blockintelai.com
CRISISMESH_PUBLIC_URL=https://crisismesh-1031148889398.us-central1.run.app

# SMS consent audit log (A2P 10DLC). Ephemeral on Cloud Run — see
# docs/A2P_10DLC_RESUBMISSION.md.
CRISISMESH_CONSENT_LOG=data/consent/sms_consent.jsonl

# WhatsApp provider: "meta" (Cloud API direct, default), "twilio" (Twilio-hosted
# sender), or "off". Each mode has its own inbound route and its own signature
# check, so a webhook is never accepted by the wrong one.
CRISISMESH_WHATSAPP_MODE=meta

# --- mode=twilio: Twilio-hosted WhatsApp sender ---
# Inbound webhook URL to set on the Twilio sender: <public-url>/whatsapp/twilio
# Reuses TWILIO_ACCOUNT_SID and the API key / auth token above.
TWILIO_WHATSAPP_FROM=whatsapp:+17722971783

# --- mode=meta: WhatsApp Cloud API direct ---
# Inbound webhook URL to set in Meta: <public-url>/whatsapp
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Cloud Storage
GCS_BUCKET=crisismesh-data
